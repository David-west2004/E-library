# Supabase Configuration
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: STORAGE SETUP
# 1. Go to Supabase Dashboard -> Storage
# 2. Create a NEW bucket named "materials"
# 3. Set it to "Public"
# 4. Add a Policy to allow "INSERT" and "SELECT" for "public" or "authenticated" users
#    (Or disable RLS for that bucket for testing)

# Email Configuration (SMTP)
# For Gmail: Use App Password (not regular password)
# Visit: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false

# Google Drive API Configuration
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Search for "Google Drive API" and click "Enable"
# 4. Go to "APIs & Services" -> "Credentials"
# 5. Click "Create Credentials" -> "API Key"
# 6. Copy the generated key and paste it here
GOOGLE_DRIVE_API_KEY=your-google-drive-api-key

# Gemini AI (Optional)
GEMINI_API_KEY=your-gemini-key

# Application
NODE_ENV=production
PORT=3000